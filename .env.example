# Copy this file to .env and put your key after the equals sign.
# .env is listed in .gitignore, so the key never reaches the repository.
ANTHROPIC_API_KEY=

# The model that answers the tasks, and the model that marks judge criteria.
# They can be the same, but a different judge avoids a model marking its own
# work. claude-haiku-5-5 is much cheaper if you want to keep costs down.
ANSWER_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5

# Where the API keeps its SQLite database.
GRADER_DB=grader.db
